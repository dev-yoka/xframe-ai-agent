    {
      "id": "setup_fee",
      "title": "Setup fee",
      "description": "Configure setup price, commitment fee, and other monthly fees.",
      "approval_mode": "per_tab",
      "prerequisites": {
        "steps": [
          "summary"
        ]
      },
      "fields": [
        {
          "id": "fee_type",
          "label": "Fee Type",
          "type": "enum",
          "required": true,
          "enum_options": [
            {
              "value": "Setup Fee",
              "label": "Setup Fee"
            },
            {
              "value": "Network Joining Fee",
              "label": "Network Joining Fee"
            }
          ]
        },
        {
          "id": "payment_schedule",
          "label": "Payment Schedule",
          "type": "enum",
          "required": true,
          "enum_options": [
            {
              "value": "100% on signature",
              "label": "100% on signature"
            },
            {
              "value": "50% on signature / 50% on go-live",
              "label": "50% on signature / 50% on go-live"
            },
            {
              "value": "Custom",
              "label": "Custom"
            }
          ]
        },
        {
          "id": "standard_commitment_fee",
          "label": "Monthly Commitment Fee",
          "type": "currency",
          "required": true,
          "validation": {
            "min": 0,
            "decimals": 2
          },
          "suggestion": {
            "mode": "proactive",
            "sources": [
              "historical"
            ],
            "historical": {
              "aggregation": "median",
              "filter_keys": [
                "customer_segment"
              ],
              "min_sample_size": 3
            },
            "confidence_threshold": 0.55
          }
        },
        {
          "id": "waived_months",
          "label": "Waived Months",
          "type": "number",
          "required": true,
          "validation": {
            "min": 0,
            "max": 6,
            "decimals": 0
          }
        },
