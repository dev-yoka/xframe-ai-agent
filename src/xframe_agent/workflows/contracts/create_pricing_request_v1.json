{
  "id": "create_pricing_request",
  "version": "v1",
  "title": "Create a pricing request",
  "steps": [
    {
      "id": "summary",
      "title": "Summary",
      "description": "Capture the opportunity, technical pricing model, and corridor scope.",
      "approval_mode": "batch_at_submit",
      "fields": [
        {
          "id": "sending_partner_name",
          "label": "Sending Partner Name",
          "type": "string",
          "required": true,
          "validation": {
            "pattern": "^.{3,120}$"
          },
          "ui": {
            "placeholder": "e.g. Acme MEA expansion",
            "group": "Quoting Details"
          }
        },
        {
          "id": "opportunity_type",
          "label": "Opportunity type",
          "type": "enum",
          "required": true,
          "enum_options": [
            {
              "value": "New partner",
              "label": "New partner"
            },
            {
              "value": "Pricing Change",
              "label": "Pricing Change"
            },
            {
              "value": "Upsell",
              "label": "Upsell"
            }
          ],
          "ui": {
            "group": "Quoting Details"
          }
        },
        {
          "id": "use_cases",
          "label": "Use Cases",
          "type": "multi_enum",
          "required": true,
          "enum_options": [
            {
              "value": "Accept and Pay",
              "label": "Accept and Pay"
            },
            {
              "value": "Accept APM's",
              "label": "Accept APM's"
            },
            {
              "value": "Pay Business payments",
              "label": "Pay Business payments"
            },
            {
              "value": "Mass Payout",
              "label": "Mass Payout"
            },
            {
              "value": "Me2Me account top up",
              "label": "Me2Me account top up"
            },
            {
              "value": "Remittance",
              "label": "Remittance"
            },
            {
              "value": "Virtual account",
              "label": "Virtual account"
            },
            {
              "value": "Global Accounts",
              "label": "Global Accounts"
            },
            {
              "value": "QR code payments",
              "label": "QR code payments"
            },
            {
              "value": "Accept Business payments",
              "label": "Accept Business payments"
            },
            {
              "value": "Account Top-Up",
              "label": "Account Top-Up"
            },
            {
              "value": "Last Mile Payout",
              "label": "Last Mile Payout"
            },
            {
              "value": "Gambling account top up",
              "label": "Gambling account top up"
            },
            {
              "value": "Gambling account withdrawl",
              "label": "Gambling account withdrawl"
            },
            {
              "value": "Insurance payouts",
              "label": "Insurance payouts"
            },
            {
              "value": "Other",
              "label": "Other"
            }
          ],
          "ui": {
            "group": "Quoting Details"
          }
        },
        {
          "id": "opportunity_owner",
          "label": "Opportunity Owner",
          "type": "string",
          "required": false,
          "ui": {
            "placeholder": "Owner name or email",
            "group": "Quoting Details"
          }
        },
        {
          "id": "sending_partner_region",
          "label": "Sending Partner Region",
          "type": "enum",
          "required": true,
          "options_source": {
            "type": "priceframe_api",
            "endpoint": "/api/v1/corridors/active/filters",
            "value_path": "geographicalRegions",
            "label_path": "geographicalRegions",
            "cache_ttl_seconds": 300
          },
          "ui": {
            "group": "Quoting Details"
          }
        },
        {
          "id": "sending_partner_country",
          "label": "Sending Partner Country",
          "type": "enum",
          "required": true,
          "options_source": {
            "type": "priceframe_api",
            "endpoint": "/api/v1/corridors/active/filters",
            "value_path": "countries",
            "label_path": "countries",
            "depends_on": [
              "sending_partner_region"
            ],
            "cache_ttl_seconds": 300
          },
          "ui": {
            "group": "Quoting Details"
          }
        },
        {
          "id": "contract_length_years",
          "label": "Contract Length (years)",
          "type": "number",
          "required": true,
          "validation": {
            "min": 1,
            "max": 5,
            "decimals": 0
          },
          "ui": {
            "group": "Quoting Details"
          }
        },
        {
          "id": "waived_months",
          "label": "Waived Months (Commitment fee)",
          "type": "number",
          "required": true,
          "validation": {
            "min": 0,
            "max": 24,
            "decimals": 0
          },
          "ui": {
            "group": "Quoting Details"
          }
        },
        {
          "id": "pr_code",
          "label": "PR Code",
          "type": "string",
          "required": false,
          "ui": {
            "placeholder": "e.g. PR-2026-1131",
            "group": "Quoting Details"
          }
        },
        {
          "id": "show_fx_source_in_contract",
          "label": "Show FX Source in contract",
          "type": "enum",
          "required": true,
          "enum_options": [
