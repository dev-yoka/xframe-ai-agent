              "value": "YES",
              "label": "YES"
            },
            {
              "value": "NO",
              "label": "NO"
            }
          ],
          "ui": {
            "group": "Quoting Details"
          }
        },
        {
          "id": "show_fx_spread_in_contract",
          "label": "Show FX Spread in contract",
          "type": "enum",
          "required": true,
          "enum_options": [
            {
              "value": "YES",
              "label": "YES"
            },
            {
              "value": "NO",
              "label": "NO"
            }
          ],
          "ui": {
            "group": "Quoting Details"
          }
        },
        {
          "id": "integration_type",
          "label": "Integration Type",
          "type": "enum",
          "required": true,
          "enum_options": [
            {
              "value": "New API Integration",
              "label": "New API Integration"
            },
            {
              "value": "Transfers with Thunes Business Hub",
              "label": "Transfers with Thunes Business Hub"
            },
            {
              "value": "Middleware Integration",
              "label": "Middleware Integration"
            },
            {
              "value": "New Vertical & Corridor",
              "label": "New Vertical & Corridor"
            },
            {
              "value": "New Corridor",
              "label": "New Corridor"
            }
          ],
          "ui": {
            "group": "Technical Pricing Details"
          }
        },
        {
          "id": "fx_model",
          "label": "FX Model",
          "type": "enum",
          "required": true,
          "enum_options": [
            {
              "value": "Traditional FX",
              "label": "Traditional FX"
            },
            {
              "value": "Trading Desk",
              "label": "Trading Desk"
            },
            {
              "value": "Both Models",
              "label": "Both Models"
            }
          ],
          "ui": {
            "group": "Technical Pricing Details"
