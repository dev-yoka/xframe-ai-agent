APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1/agent
# v1 production: mobile app origins (native apps can omit Origin header)
CORS_ORIGINS=https://priceframe-yg.buy-frame.com
# Local dev: add localhost origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8100

DATABASE_URL=postgresql+asyncpg://xframe:xframe@localhost:5433/xframe_agent
REDIS_URL=redis://localhost:6379/0

# v1 production (deployed PriceFRAME)
PRICEFRAME_BASE_URL=https://priceframe-yg.buy-frame.com
# Get these from the deployed PriceFRAME's configuration
PRICEFRAME_JWT_SECRET=6WSlYHEA7OI4wW9hcEV261A2xLyGHEVWdFIdWRByWDD
PRICEFRAME_SERVICE_SECRET=<obtain-from-deployed-priceframe>

# Local dev (uncomment to use local PriceFRAME instead)
# PRICEFRAME_BASE_URL=http://localhost:3333
# PRICEFRAME_JWT_SECRET=replace-me
# PRICEFRAME_SERVICE_SECRET=replace-me
PRICEFRAME_JWT_ALGORITHM=HS256
PRICEFRAME_PROFILE_CACHE_TTL_SECONDS=60
PRICEFRAME_TIMEOUT_SECONDS=10
PRICEFRAME_MAX_RETRIES=2

HEALTH_CHECK_EXTERNALS=true
PROMETHEUS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=xframe-agent-dev
ATTACHMENT_STORAGE_BACKEND=s3
ATTACHMENT_LOCAL_STORAGE_PATH=.data/attachments
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_SCAN_MODE=inline
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

ALLOW_REAL_DATA=false

# LLM providers, in runtime order:
# 1. Gemini Developer API via API key, matching the generativelanguage.googleapis.com curl flow
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_MAX_RETRIES=2
GEMINI_API_RETRY_BASE_DELAY_SECONDS=0.25
# 2. Gemini Vertex, when no Gemini API key is configured
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=us-central1
# 3. Anthropic fallback
ANTHROPIC_API_KEY=

# Backward-compatible alias for GEMINI_API_KEY.
GEMINI_AISTUDIO_API_KEY=
